
# Secret de ejemplo para PostgreSQL
# Rol 04 - Credenciales de base de datos
# NO utilizar credenciales reales en este archivo

apiVersion: v1
kind: Secret
metadata:
  name: db-secret
  namespace: maximos
type: Opaque
stringData:
  DB_USER: "USUARIO_DE_EJEMPLO"
  DB_PASSWORD: "CONTRASENA_DE_EJEMPLO"
